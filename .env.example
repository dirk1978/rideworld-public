# RideWorld settings (setup.sh copies this to .env; Docker reads it too)
# Port the HTTPS server listens on
PORT=8443
# Your public address, if people reach it from the internet (Strava's sign-in returns here); leave empty on a LAN
PUBLIC_URL=
# Where registration notices go when not set in the app (Accounts -> Email)
NOTIFY_EMAIL=
# Docker only: the first admin's username (its password is printed in the logs on the first start)
ADMIN_USER=admin
# Docker only: this computer's LAN address, added to the self-signed certificate
HOST_IP=
