<workout_file>
    <author>RideWorld tests</author>
    <name>Test 2x2</name>
    <description>A short made-up workout for the tests</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="120" PowerLow="0.40" PowerHigh="0.70"/>
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="30" OnPower="1.10" OffPower="0.50" Cadence="95"/>
        <SteadyState Duration="90" Power="0.80"/>
        <FreeRide Duration="60" FlatRoad="1"/>
        <Cooldown Duration="120" PowerLow="0.60" PowerHigh="0.35"/>
    </workout>
</workout_file>
